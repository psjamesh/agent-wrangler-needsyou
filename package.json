{
  "name": "agent-wrangler-needsyou",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "description": "A triage queue of the decisions and actions your sessions need from you. An Agent Wrangler extension.",
  "license": "MIT",
  "scripts": {
    "test": "node --test --import ./test-setup.js 'server/**/*.test.js' 'public/**/*.test.js'",
    "lint": "eslint --max-warnings 0 .",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "verify": "npm run check:lockfile && npm run lint && npm test"
  },
  "wranglerExtension": {
    "id": "needsyou",
    "label": "Needs you",
    "description": "A triage queue of the decisions and actions your sessions need from you.",
    "author": "PortSwigger",
    "requires": [
      "sessions:read",
      "tasks:read",
      "deliver",
      "board:rebuild"
    ],
    "engines": {
      "wranglerApi": "^1.57.0"
    },
    "homepage": "https://github.com/portswigger-tim/agent-wrangler-needsyou"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/portswigger-tim/agent-wrangler-needsyou.git"
  }
}
